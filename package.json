{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "description": "Project-oriented coding agent desktop app built on the Pi SDK",
  "author": "Duy Le",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "rebuild:electron": "electron-builder install-app-deps",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "npm run rebuild:node && vitest run",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "build": {
    "appId": "com.duyle.pi-agent-desktop",
    "productName": "Pi Agent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "better-sqlite3": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
